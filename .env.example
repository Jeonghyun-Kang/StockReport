# ===== DART (전자공시) =====
DART_API_KEY=               # https://opendart.fss.or.kr 인증키(무료)

# ===== 네이버 (데이터랩 트렌드 + 뉴스 검색) =====
NAVER_CLIENT_ID=            # https://developers.naver.com
NAVER_CLIENT_SECRET=

# ===== LLM (OpenAI 호환 엔드포인트, 모델 비종속) =====
LLM_BASE_URL=               # 예: https://api.openai.com/v1 또는 호환 엔드포인트
LLM_API_KEY=
LLM_MODEL=                  # 사용할 모델 식별자 (예: gpt-4o-mini 등)

# ===== 임베딩 =====
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
# OpenAI 호환 임베딩을 쓰려면 아래 지정(없으면 sentence-transformers → TF-IDF 순으로 fallback)
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_API_MODEL=text-embedding-3-small

